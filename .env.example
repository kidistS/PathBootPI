# ─────────────────────────────────────────────────────────────────────────────
# PathBoot – Environment Variables Example
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it is listed in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# API keys (used by X-API-Key header for all /api/v1/chat requests)
PATHBOOT_API_KEY_1=pathboot-dev-key-2026
PATHBOOT_API_KEY_2=pathboot-local-key-001

# Login credentials for POST /api/v1/auth/login
PATHBOOT_ADMIN_PASSWORD=pathboot-admin-2026
PATHBOOT_USER_PASSWORD=pathboot-user-2026

